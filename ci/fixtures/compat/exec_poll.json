{
  "description": "exec_poll: byte-offset deltas over a session's captured output. Polled here on a finished session so every field is deterministic: full delta, offset slicing, and offset==len giving an empty delta. exec_poll shares the renderSessionState payload with exec_wait: ok, done, exit_code, stdout, stderr, stdout_offset, stderr_offset, truncated_stdout, truncated_stderr, duration_ms. Like exec_wait, the session is resolved before optional-argument types are validated: an unknown session_id beats a bad stdout_offset type and answers UnknownSession.",
  "platforms": ["posix"],
  "platforms_reason": "golden session argv use POSIX paths; Windows goldens are future work",
  "cases": [
    {
      "name": "setup_start_echo",
      "request": {"jsonrpc": "2.0", "id": 90, "method": "tools/call", "params": {"name": "exec_start", "arguments": {"argv": ["/bin/echo", "compat-poll"]}}},
      "expect": {
        "status": 200,
        "response": {"jsonrpc": "2.0", "id": 90, "result": {"content": [{"type": "text", "text": {"*str": null}}], "structuredContent": {"ok": true, "session_id": {"*int": null}, "pid": {"*int": null}}, "isError": false}},
        "capture": {"sid": "result.structuredContent.session_id"}
      }
    },
    {
      "name": "setup_wait_until_done",
      "request": {"jsonrpc": "2.0", "id": 91, "method": "tools/call", "params": {"name": "exec_wait", "arguments": {"session_id": "$sid", "timeout": 10}}},
      "expect": {
        "status": 200,
        "response": {"jsonrpc": "2.0", "id": 91, "result": {"content": [{"type": "text", "text": {"*str": null}}], "structuredContent": {"ok": true, "done": true, "exit_code": 0, "stdout": "compat-poll\n", "stderr": "", "stdout_offset": 12, "stderr_offset": 0, "truncated_stdout": false, "truncated_stderr": false, "duration_ms": {"*int": null}}, "isError": false}}
      }
    },
    {
      "name": "poll_full_delta",
      "request": {"jsonrpc": "2.0", "id": 59, "method": "tools/call", "params": {"name": "exec_poll", "arguments": {"session_id": "$sid"}}},
      "expect": {
        "status": 200,
        "response": {"jsonrpc": "2.0", "id": 59, "result": {"content": [{"type": "text", "text": {"*str": null}}], "structuredContent": {"ok": true, "done": true, "exit_code": 0, "stdout": "compat-poll\n", "stderr": "", "stdout_offset": 12, "stderr_offset": 0, "truncated_stdout": false, "truncated_stderr": false, "duration_ms": {"*int": null}}, "isError": false}}
      }
    },
    {
      "name": "poll_offset_slice",
      "request": {"jsonrpc": "2.0", "id": 60, "method": "tools/call", "params": {"name": "exec_poll", "arguments": {"session_id": "$sid", "stdout_offset": 7}}},
      "expect": {
        "status": 200,
        "response": {"jsonrpc": "2.0", "id": 60, "result": {"content": [{"type": "text", "text": {"*str": null}}], "structuredContent": {"ok": true, "done": true, "exit_code": 0, "stdout": "poll\n", "stderr": "", "stdout_offset": 12, "stderr_offset": 0, "truncated_stdout": false, "truncated_stderr": false, "duration_ms": {"*int": null}}, "isError": false}}
      }
    },
    {
      "name": "missing_session_id",
      "request": {"jsonrpc": "2.0", "id": 62, "method": "tools/call", "params": {"name": "exec_poll", "arguments": {}}},
      "expect": {
        "status": 200,
        "response": {"jsonrpc": "2.0", "id": 62, "result": {"content": [{"type": "text", "text": {"*str": null}}], "structuredContent": {"ok": false, "error": "MissingSession"}, "isError": false}}
      }
    },
    {
      "name": "session_id_wrong_type_invalid_params",
      "request": {"jsonrpc": "2.0", "id": 64, "method": "tools/call", "params": {"name": "exec_poll", "arguments": {"session_id": "1"}}},
      "expect": {
        "status": 200,
        "response": {"jsonrpc": "2.0", "id": 64, "error": {"code": -32602, "message": "Invalid params"}}
      }
    },
    {
      "name": "unknown_session_checked_before_offset_type",
      "request": {"jsonrpc": "2.0", "id": 63, "method": "tools/call", "params": {"name": "exec_poll", "arguments": {"session_id": 999999, "stdout_offset": "abc"}}},
      "expect": {
        "status": 200,
        "response": {"jsonrpc": "2.0", "id": 63, "result": {"content": [{"type": "text", "text": "{\"ok\":false,\"error\":\"UnknownSession\"}"}], "structuredContent": {"ok": false, "error": "UnknownSession"}, "isError": false}}
      }
    }
  ]
}
