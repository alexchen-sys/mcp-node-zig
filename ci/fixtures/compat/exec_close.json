{
  "description": "exec_close: idempotent teardown. Closing a finished session: {ok:true}. Closing the same session again: {ok:true, already_closed:true} — the v0 idempotency contract also covers a session id that never existed.",
  "platforms": ["posix"],
  "platforms_reason": "golden session argv use POSIX paths; Windows goldens are future work",
  "cases": [
    {
      "name": "setup_start_true",
      "request": {"jsonrpc": "2.0", "id": 92, "method": "tools/call", "params": {"name": "exec_start", "arguments": {"argv": ["/usr/bin/true"]}}},
      "expect": {
        "status": 200,
        "response": {"jsonrpc": "2.0", "id": 92, "result": {"content": [{"type": "text", "text": {"*str": null}}], "structuredContent": {"ok": true, "session_id": {"*int": null}, "pid": {"*int": null}}, "isError": false}},
        "capture": {"sid": "result.structuredContent.session_id"}
      }
    },
    {
      "name": "setup_wait_until_done",
      "request": {"jsonrpc": "2.0", "id": 93, "method": "tools/call", "params": {"name": "exec_wait", "arguments": {"session_id": "$sid", "timeout": 10}}},
      "expect": {
        "status": 200,
        "response": {"jsonrpc": "2.0", "id": 93, "result": {"content": [{"type": "text", "text": {"*str": null}}], "structuredContent": {"ok": true, "done": true, "exit_code": 0, "stdout": "", "stderr": "", "stdout_offset": 0, "stderr_offset": 0, "truncated_stdout": false, "truncated_stderr": false, "duration_ms": {"*int": null}, "duration_us": {"*int": null}}, "isError": false}}
      }
    },
    {
      "name": "close_finished_session",
      "request": {"jsonrpc": "2.0", "id": 65, "method": "tools/call", "params": {"name": "exec_close", "arguments": {"session_id": "$sid"}}},
      "expect": {
        "status": 200,
        "response": {"jsonrpc": "2.0", "id": 65, "result": {"content": [{"type": "text", "text": "{\"ok\":true}"}], "structuredContent": {"ok": true}, "isError": false}}
      }
    },
    {
      "name": "close_is_idempotent",
      "request": {"jsonrpc": "2.0", "id": 66, "method": "tools/call", "params": {"name": "exec_close", "arguments": {"session_id": "$sid"}}},
      "expect": {
        "status": 200,
        "response": {"jsonrpc": "2.0", "id": 66, "result": {"content": [{"type": "text", "text": "{\"ok\":true,\"already_closed\":true}"}], "structuredContent": {"ok": true, "already_closed": true}, "isError": false}}
      }
    },
    {
      "name": "close_unknown_session_id",
      "request": {"jsonrpc": "2.0", "id": 67, "method": "tools/call", "params": {"name": "exec_close", "arguments": {"session_id": 999999}}},
      "expect": {
        "status": 200,
        "response": {"jsonrpc": "2.0", "id": 67, "result": {"content": [{"type": "text", "text": "{\"ok\":true,\"already_closed\":true}"}], "structuredContent": {"ok": true, "already_closed": true}, "isError": false}}
      }
    },
    {
      "name": "missing_session_id",
      "request": {"jsonrpc": "2.0", "id": 94, "method": "tools/call", "params": {"name": "exec_close", "arguments": {}}},
      "expect": {
        "status": 200,
        "response": {"jsonrpc": "2.0", "id": 94, "result": {"content": [{"type": "text", "text": "{\"ok\":false,\"error\":\"MissingSession\"}"}], "structuredContent": {"ok": false, "error": "MissingSession"}, "isError": false}}
      }
    }
  ]
}
