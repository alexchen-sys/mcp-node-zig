{
  "description": "exec_shell: one shell layer (bash -c by default on POSIX). The payload is the exec payload: ok, exit_code, stdout, stderr, truncated, duration_ms, duration_us. Shell choice outside the platform allowlist is a tool-domain error.",
  "platforms": ["posix"],
  "platforms_reason": "the default-shell golden is bash -c (POSIX); Windows shell goldens are future work",
  "cases": [
    {
      "name": "script_success_default_shell",
      "request": {"jsonrpc": "2.0", "id": 53, "method": "tools/call", "params": {"name": "exec_shell", "arguments": {"script": "echo shell-ok"}}},
      "expect": {
        "status": 200,
        "response": {"jsonrpc": "2.0", "id": 53, "result": {"content": [{"type": "text", "text": {"*str": null}}], "structuredContent": {"ok": true, "exit_code": 0, "stdout": "shell-ok\n", "stderr": "", "truncated": false, "duration_ms": {"*int": null}, "duration_us": {"*int": null}}, "isError": false}}
      }
    },
    {
      "name": "missing_script",
      "request": {"jsonrpc": "2.0", "id": 54, "method": "tools/call", "params": {"name": "exec_shell", "arguments": {}}},
      "expect": {
        "status": 200,
        "response": {"jsonrpc": "2.0", "id": 54, "result": {"content": [{"type": "text", "text": {"*str": null}}], "structuredContent": {"ok": false, "error": "MissingScript"}, "isError": false}}
      }
    },
    {
      "name": "script_wrong_type_invalid_params",
      "request": {"jsonrpc": "2.0", "id": 56, "method": "tools/call", "params": {"name": "exec_shell", "arguments": {"script": 5}}},
      "expect": {
        "status": 200,
        "response": {"jsonrpc": "2.0", "id": 56, "error": {"code": -32602, "message": "Invalid params"}}
      }
    },
    {
      "name": "unsupported_shell",
      "request": {"jsonrpc": "2.0", "id": 55, "method": "tools/call", "params": {"name": "exec_shell", "arguments": {"script": "echo hi", "shell": "csh"}}},
      "expect": {
        "status": 200,
        "response": {"jsonrpc": "2.0", "id": 55, "result": {"content": [{"type": "text", "text": {"*str": null}}], "structuredContent": {"ok": false, "error": "UnsupportedShell"}, "isError": false}}
      }
    }
  ]
}
