{
  "description": "exec_write: base64 stdin writes to a live session, eof=true closes stdin. Payload: ok, bytes, eof. The flow uses /bin/cat so the written bytes must come back on stdout after eof (done implies drained). Argument types are validated before session resolution: data_b64 is the first gate.",
  "platforms": ["posix"],
  "platforms_reason": "golden session argv use POSIX paths; Windows goldens are future work",
  "cases": [
    {
      "name": "setup_start_cat",
      "request": {"jsonrpc": "2.0", "id": 69, "method": "tools/call", "params": {"name": "exec_start", "arguments": {"argv": ["/bin/cat"]}}},
      "expect": {
        "status": 200,
        "response": {"jsonrpc": "2.0", "id": 69, "result": {"content": [{"type": "text", "text": {"*str": null}}], "structuredContent": {"ok": true, "session_id": {"*int": null}, "pid": {"*int": null}}, "isError": false}},
        "capture": {"sid": "result.structuredContent.session_id"}
      }
    },
    {
      "name": "write_bytes_with_eof",
      "request": {"jsonrpc": "2.0", "id": 70, "method": "tools/call", "params": {"name": "exec_write", "arguments": {"session_id": "$sid", "data_b64": "cGluZwo=", "eof": true}}},
      "expect": {
        "status": 200,
        "response": {"jsonrpc": "2.0", "id": 70, "result": {"content": [{"type": "text", "text": "{\"ok\":true,\"bytes\":5,\"eof\":true}"}], "structuredContent": {"ok": true, "bytes": 5, "eof": true}, "isError": false}}
      }
    },
    {
      "name": "wait_cat_echoes_written_bytes",
      "request": {"jsonrpc": "2.0", "id": 72, "method": "tools/call", "params": {"name": "exec_wait", "arguments": {"session_id": "$sid", "timeout": 10}}},
      "expect": {
        "status": 200,
        "response": {"jsonrpc": "2.0", "id": 72, "result": {"content": [{"type": "text", "text": {"*str": null}}], "structuredContent": {"ok": true, "done": true, "exit_code": 0, "stdout": "ping\n", "stderr": "", "stdout_offset": 5, "stderr_offset": 0, "truncated_stdout": false, "truncated_stderr": false, "duration_ms": {"*int": null}}, "isError": false}}
      }
    },
    {
      "name": "missing_data_b64_checked_before_session",
      "request": {"jsonrpc": "2.0", "id": 74, "method": "tools/call", "params": {"name": "exec_write", "arguments": {"session_id": 999999}}},
      "expect": {
        "status": 200,
        "response": {"jsonrpc": "2.0", "id": 74, "result": {"content": [{"type": "text", "text": "{\"ok\":false,\"error\":\"MissingData\"}"}], "structuredContent": {"ok": false, "error": "MissingData"}, "isError": false}}
      }
    },
    {
      "name": "data_b64_wrong_type_invalid_params",
      "request": {"jsonrpc": "2.0", "id": 75, "method": "tools/call", "params": {"name": "exec_write", "arguments": {"session_id": 999999, "data_b64": 5}}},
      "expect": {
        "status": 200,
        "response": {"jsonrpc": "2.0", "id": 75, "error": {"code": -32602, "message": "Invalid params"}}
      }
    }
  ]
}
