{
  "description": "read_file: text read with character-sliced offset/limit and has_more paging signal. Payload: ok, path, size, offset, content, has_more. The setup case writes the 10-char fixture file via write_file inside the daemon temp cwd; all paths are relative to that cwd.",
  "cases": [
    {
      "name": "setup_write_ten_chars",
      "request": {"jsonrpc": "2.0", "id": 106, "method": "tools/call", "params": {"name": "write_file", "arguments": {"path": "compat-read.txt", "content_b64": "MDEyMzQ1Njc4OQ=="}}},
      "expect": {
        "status": 200,
        "response": {"jsonrpc": "2.0", "id": 106, "result": {"content": [{"type": "text", "text": "{\"ok\":true,\"path\":\"compat-read.txt\",\"size\":10,\"sha256\":\"84d89877f0d4041efb6bf91a16f0248f2fd573e6af05c19f96bedb9f882f7882\"}"}], "structuredContent": {"ok": true, "path": "compat-read.txt", "size": 10, "sha256": "84d89877f0d4041efb6bf91a16f0248f2fd573e6af05c19f96bedb9f882f7882"}, "isError": false}}
      }
    },
    {
      "name": "read_full_content",
      "request": {"jsonrpc": "2.0", "id": 107, "method": "tools/call", "params": {"name": "read_file", "arguments": {"path": "compat-read.txt"}}},
      "expect": {
        "status": 200,
        "response": {"jsonrpc": "2.0", "id": 107, "result": {"content": [{"type": "text", "text": "{\"ok\":true,\"path\":\"compat-read.txt\",\"size\":10,\"offset\":0,\"content\":\"0123456789\",\"has_more\":false}"}], "structuredContent": {"ok": true, "path": "compat-read.txt", "size": 10, "offset": 0, "content": "0123456789", "has_more": false}, "isError": false}}
      }
    },
    {
      "name": "read_limit_reports_has_more",
      "request": {"jsonrpc": "2.0", "id": 108, "method": "tools/call", "params": {"name": "read_file", "arguments": {"path": "compat-read.txt", "limit": 4}}},
      "expect": {
        "status": 200,
        "response": {"jsonrpc": "2.0", "id": 108, "result": {"content": [{"type": "text", "text": "{\"ok\":true,\"path\":\"compat-read.txt\",\"size\":10,\"offset\":0,\"content\":\"0123\",\"has_more\":true}"}], "structuredContent": {"ok": true, "path": "compat-read.txt", "size": 10, "offset": 0, "content": "0123", "has_more": true}, "isError": false}}
      }
    },
    {
      "name": "missing_path",
      "request": {"jsonrpc": "2.0", "id": 109, "method": "tools/call", "params": {"name": "read_file", "arguments": {}}},
      "expect": {
        "status": 200,
        "response": {"jsonrpc": "2.0", "id": 109, "result": {"content": [{"type": "text", "text": "{\"ok\":false,\"error\":\"MissingPath\"}"}], "structuredContent": {"ok": false, "error": "MissingPath"}, "isError": false}}
      }
    },
    {
      "name": "path_wrong_type_invalid_params",
      "request": {"jsonrpc": "2.0", "id": 110, "method": "tools/call", "params": {"name": "read_file", "arguments": {"path": 5}}},
      "expect": {
        "status": 200,
        "response": {"jsonrpc": "2.0", "id": 110, "error": {"code": -32602, "message": "Invalid params"}}
      }
    },
    {
      "name": "not_found",
      "request": {"jsonrpc": "2.0", "id": 111, "method": "tools/call", "params": {"name": "read_file", "arguments": {"path": "no-such-compat-file.txt"}}},
      "expect": {
        "status": 200,
        "response": {"jsonrpc": "2.0", "id": 111, "result": {"content": [{"type": "text", "text": "{\"ok\":false,\"error\":\"FileNotFound\"}"}], "structuredContent": {"ok": false, "error": "FileNotFound"}, "isError": false}}
      }
    }
  ]
}
